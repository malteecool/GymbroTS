{
  "expo": {
    "name": "Gymbro",
    "slug": "GymbroTS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.malteiscool.gymbrots",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.malteiscool.GymbroTS"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1c1a1a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gymbro to access your photos to set a profile picture or attach a photo to a post.",
          "cameraPermission": "Allow Gymbro to access your camera to take a profile picture or a post photo."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bb3bdc10-a425-4aeb-94f6-ab0ab59df2ec"
      }
    },
    "backgroundColor": "#121111"
  }
}
